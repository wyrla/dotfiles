general {
        output_format = "i3bar"
        colors = false
        markup = pango
        interval = 1
}

order += "memory"
order += "disk /"
order += "wireless wlp11s0"
order += "volume master"
order += "tztime local"

memory {
        format = "📝 %used / %total"
        threshold_degraded = "10%"
}

disk "/" {
        format = "💽 %avail"
}

wireless wlp11s0 {
        format_up = "📡%quality at %essid, %bitrate"
        format_down = "W: down"
}

volume master {
        format = "🔊 %volume"
        format_muted = "🔇"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}


tztime local {
        // format_time = "⌛ %time"
        format = "⌛ %a %-d %b %H:%M"
}
